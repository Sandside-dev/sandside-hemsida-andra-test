# Pooled Postgres connection string from Supabase (server only).
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?sslmode=require

# Optional email. Bookings are still saved if email is not configured or fails.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=Sandside UF <bokning@example.se>
BOOKING_NOTIFY_EMAIL=hej@example.se

# Public canonical URL used in metadata after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
